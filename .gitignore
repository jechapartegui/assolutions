# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings
*-errors.txt

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

.angular
.tsc.out

# Generated i18n files
apps/assolutions-front/src/locale/messages.xlf
apps/assolutions-front/src/locale/messages.en.json

# Environment files: never commit secrets
.env
.env.*
*.env
!.env.example
!.env.*.example
apps/assolutions-back/.env
apps/assolutions-back/.env.*
!apps/assolutions-back/.env.example
!apps/assolutions-back/.env.*.example

# Local database exports / personal-data extracts: never commit
**/DOUBLONS*.csv
**/doublons*.csv
**/*.backup
**/*.dump
apps/assolutions-back/exports/
