{
  "name": "@assolutions/front",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "npm run start:local",
    "start:local": "cd ../.. && nx serve assolutions-front --configuration=development",
    "start:local:en": "cd ../.. && nx serve assolutions-front --configuration=development-en",
    "build": "npm run build:prod",
    "build:preprod": "cd ../.. && nx build assolutions-front --configuration=preprod --skip-nx-cache",
    "build:prod": "cd ../.. && nx build assolutions-front --configuration=production --skip-nx-cache",
    "deploy:preprod": "npm run build:preprod",
    "deploy:prod": "npm run build:prod",
    "nx:reset": "cd ../.. && nx reset"
  },
  "dependencies": {
    "@angular/animations": "20.3.15",
    "@angular/common": "20.3.15",
    "@angular/compiler": "20.3.15",
    "@angular/core": "20.3.15",
    "@angular/forms": "20.3.15",
    "@angular/localize": "20.3.15",
    "@angular/platform-browser": "20.3.15",
    "@angular/platform-browser-dynamic": "20.3.15",
    "@angular/router": "20.3.15",
    "crypto-js": "^4.2.0",
    "file-saver": "^2.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {}
}
