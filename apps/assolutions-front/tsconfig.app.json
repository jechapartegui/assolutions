{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "emitDeclarationOnly": false,
    "outDir": "./out-tsc/app",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["@angular/localize"],
    "skipLibCheck": true
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ]
}