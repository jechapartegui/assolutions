# Assolutions back - PRODUCTION
NODE_ENV=production
APP_ENV=production

# Front public utilisé par les callbacks HelloAsso
FRONT_URL=https://assolutions.club
HELLOASSO_FRONT_URL=https://assolutions.club

# HelloAsso PRODUCTION - paiements réels
HELLOASSO_ENV=production
HELLOASSO_API_URL=https://api.helloasso.com/v5
HELLOASSO_OAUTH_URL=https://api.helloasso.com/oauth2/token
HELLOASSO_ORGANIZATION_SLUG=us-ivry-roller
HELLOASSO_CLIENT_ID=VOTRE_CLIENT_ID_PRODUCTION
HELLOASSO_CLIENT_SECRET=VOTRE_CLIENT_SECRET_PRODUCTION

# Ne jamais utiliser ces identifiants sur le service préprod.
