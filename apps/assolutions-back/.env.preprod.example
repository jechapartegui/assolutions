# Assolutions back - PREPRODUCTION
NODE_ENV=production
APP_ENV=preprod

# Front public utilisé par les callbacks HelloAsso
FRONT_URL=https://preprod.assolutions.club
HELLOASSO_FRONT_URL=https://preprod.assolutions.club

# HelloAsso SANDBOX uniquement
HELLOASSO_ENV=sandbox
HELLOASSO_API_URL=https://api.helloasso-sandbox.com/v5
HELLOASSO_OAUTH_URL=https://api.helloasso-sandbox.com/oauth2/token
HELLOASSO_ORGANIZATION_SLUG=VOTRE_ORGANISATION_SANDBOX
HELLOASSO_CLIENT_ID=VOTRE_CLIENT_ID_SANDBOX
HELLOASSO_CLIENT_SECRET=VOTRE_CLIENT_SECRET_SANDBOX

# Ne jamais mettre les identifiants de production dans le service préprod.
