{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "assolutions-back",
  "root": "apps/assolutions-back",
  "sourceRoot": "apps/assolutions-back/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "apps/assolutions-back/src/main.ts",
        "tsConfig": "apps/assolutions-back/tsconfig.build.json",
        "bundle": true,
        "platform": "node",
        "format": ["cjs"],
        "outputPath": "dist/apps/assolutions-back",
        "generatePackageJson": false,
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/assolutions-back/src/assets",
            "output": "assets"
          }
        ]
      },
      "configurations": {
        "development": {
          "sourceMap": true,
          "minify": false
        },
        "production": {
          "sourceMap": false,
          "minify": false
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "npm run start:dev --workspace @assolutions/back"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    }
  },
  "tags": []
}
