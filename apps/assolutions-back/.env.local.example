APP_ENV=local
APP_ENV_LABEL=LOCAL
NODE_ENV=development
PORT=3000

FRONT_URL=http://localhost:2211
HELLOASSO_FRONT_URL=http://localhost:2211
FFRS_PUBLIC_API_URL=http://localhost:3000

DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/assolutions-db?schema=public
# Utilisé uniquement par npm run db:preprod-to-local. Ne jamais versionner la vraie URL.
DATABASE_PREPROD=postgresql://USER:PASSWORD@PREPROD_HOST:5432/PREPROD_DB?sslmode=require
DB_SYNCHRONIZE=false

# Auth/security - generate long independent random values locally.
JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET
JWT_EXPIRES_IN=12h
TOKEN_PEPPER=CHANGE_ME_LOCAL_TOKEN_PEPPER
# Temporary only while legacy HMAC password hashes still exist.
PASSWORD_LEGACY_PEPPER=CHANGE_ME_OLD_PEPPER
PEPPER=CHANGE_ME_LEGACY_ONLY

# #20 Administration Projet : code d'élévation temporaire (12 caractères minimum).
# Ne jamais mettre la vraie valeur dans Git.
ADMIN_PROJECT_SUPER_CODE=CHANGE_ME_LONG_RANDOM_ADMIN_CODE
ADMIN_PROJECT_ELEVATION_TTL_MINUTES=15

MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=assolutions.club@gmail.com
MAIL_SMTP_PASS=CHANGE_ME
MAIL_MAX_PER_MINUTE=30
MAIL_SANDBOX=true

HELLOASSO_ENV=sandbox
HELLOASSO_API_URL=https://api.helloasso-sandbox.com/v5
HELLOASSO_OAUTH_URL=https://api.helloasso-sandbox.com/oauth2/token
HELLOASSO_ORGANIZATION_SLUG=CHANGE_ME_SANDBOX
HELLOASSO_CLIENT_ID=CHANGE_ME_SANDBOX
HELLOASSO_CLIENT_SECRET=CHANGE_ME_SANDBOX
