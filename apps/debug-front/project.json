{
  "name": "debug-front",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/debug-front/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/debug-front",
        "index": "apps/debug-front/src/index.html",
        "main": "apps/debug-front/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/debug-front/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/debug-front/public"
          }
        ],
        "styles": ["apps/debug-front/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "fileReplacements": [
            {
              "replace": "apps/assolutions-front/src/environments/environment.prod.ts",
              "with": "apps/assolutions-front/src/environments/environment.ts"
            }
          ]
        },
        "preprod": {
  "outputHashing": "all",
  "fileReplacements": [
    {
      "replace": "apps/debug-front/src/environments/environment.ts",
      "with": "apps/debug-front/src/environments/environment.preprod.ts"
    }
  ]
}
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "proxyConfig": "apps/debug-front/proxy.conf.json",
      "executor": "@angular-devkit/build-angular:dev-server", "configurations": {
        "development": {
          "buildTarget": "debug-front:build:development",
          "port": 2510,
          "proxyConfig": "apps/debug-front/proxy.conf.json"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "debug-front:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "debug-front:build",
        "spa": true
      }
    }
  }
}
